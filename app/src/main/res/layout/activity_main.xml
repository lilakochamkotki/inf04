<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#5F9EA0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="horizontal"
            android:gravity="center">

                <ImageView
                    android:id="@+id/zdjecie"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/odcisk"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter" />

        </LinearLayout>

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Numer"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/numer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0FFFF"
            android:inputType="number" />

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Imię"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/imie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0FFFF" />

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Nazwisko"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/nazwisko"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0FFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kolor oczu"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/kolorOczu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/niebieskie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="niebieskie"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/zielone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="zielone" />

                <RadioButton
                    android:id="@+id/piwne"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="piwne" />

        </RadioGroup>
        <Button
            android:id="@+id/ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="OK"
            android:textColor="@color/black"
            android:backgroundTint="#F0FFFF" />

</LinearLayout>
